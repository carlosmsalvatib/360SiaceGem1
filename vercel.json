{
  "version": 2,
  "framework": null,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/Uploads/(.*)",
      "dest": "/Uploads/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/Uploads/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/img/favicon.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
